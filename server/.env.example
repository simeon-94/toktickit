DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toktickit?schema=public"
PORT=4000
# Required. Use any long random string for local development; never commit a real secret.
JWT_SECRET=replace-with-a-long-random-string
# Optional (default 8h). Must include a unit, e.g. 8h, 30m or "2 days"; checked at startup.
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
# Optional: database for the server test suite. Default: the DATABASE_URL database name + "_test".
# It is dropped and recreated on every `npm test`, so never point it at real data.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toktickit_test?schema=public"
